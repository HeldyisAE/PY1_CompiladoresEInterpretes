------------------- Producciones -------------------
Caracteres y texto
    <letra> ::= [a-zA-Z]
    <digito> ::= [0-9]
    <digito_no_cero> ::= [1-9]
    <cero> ::= 0
    <lista_digitos> ::= <digito> | <digito> <lista_digitos>
    <simbolo> ::= "\@" | "\#" | "\$" | "\%" | "\^" | "\&" | "\*" | "\(" | "\)" | "\-" | "\_" | "\=" | "\+" | "\[" | "\]" | "\{" | "\}" | "\;" | "\:" | "\'" | "\<" | "\>" | "\," | "\." | "\/" | "\?" | "\\" | "\`" | "\~"
    <caracter> ::= <letra> | <digito> | <simbolo>
    <texto> ::= <caracter> | <caracter> <texto>
    <punto> ::= "\."
    <operadorExponencial> ::= "E" | "e"
    <comillaDoble> ::= "\""
    <comillaSimple> ::= "\'"
    <guionBajo> ::= "\_"

Tipos y valores
    <tipoInt> ::= "int"
    <tipoFloat> ::= "float"
    <tipoBool> ::= "bool"
    <tipoChar> ::= "char"
    <tipoString> ::= "string"
    <tipoVoid> ::= "void"
    <true> ::= "true"
    <false> ::= "false"
    <negativoNumero> ::= "\-"
    <not> ::= "Σ"
    <palabraVal> ::= "val"
    <leer> ::= "read"
    <escribir> ::= "write"
    <varGlobal> ::= "dg"
    <varLocal> ::= "dl"
    <vacio> ::= ε

Delimitadores y operadores
    <abrir_bloque> ::= "¿:"
    <cerrar_bloque> ::= ":?"
    <abrir_parentesis> ::= "є:"
    <cerrar_parentesis> ::= ":э"
    <abrir_corcheteCuadrados> ::= "ʃ:"
    <cerrar_corcheteCuadrados> ::= ":ʅ"
    <coma> ::= ","
    <fin_sentencia> ::= "»"
    <asignacion> ::= "Ͱ"
    <incremento> ::= "++"
    <decremento> ::= "--"
    <palabraBreak> ::= "break"
    <palabraReturn> ::= "return"
    <palabraDefun> ::= "defun"
    <palabraPrincipal> ::= "principal"
    <operadorPotencia> ::= "pot"

Palabras y operadores
    <simboloComentarioLinea> ::= "|"
    <simboloInicioComentario> ::= "¡"
    <simboloFinComentario> ::= "!"
    <simboloSuma> ::= "+"
    <simboloResta> ::= "-"
    <simboloMultiplicacion> ::= "*"
    <simboloDivision> ::= "/"
    <simboloDivisionEntera> ::= "//"
    <simboloMenor> ::= "<"
    <simboloMayor> ::= ">"
    <simboloMenorIgual> ::= "<="
    <simboloMayorIgual> ::= ">="
    <simboloIgual> ::= "=="
    <simboloDiferente> ::= "!="
    <simboloAnd> ::= "λ"
    <simboloOr> ::= "θ"
    <palabraIf> ::= "if"
    <palabraElif> ::= "elif"
    <palabraElse> ::= "else"
    <palabraWhile> ::= "while"
    <palabraFor> ::= "for"
    <modulo> ::= "mod"

Literales
    <entero> ::= <cero> | <digito_no_cero> <lista_digitos>
    <lista_digitos_no_cero_final> ::= <digito_no_cero> | <digito> <lista_digitos_no_cero_final>
    <flotante> ::= <cero> <punto> <cero> | <cero> <punto> <lista_digitos_no_cero_final> | <digito_no_cero> <lista_digitos> <punto> <lista_digitos_no_cero_final>
    <exponencial> ::= <entero> <operadorExponencial> <entero>
    <bool> ::= <true> | <false>
    <cadena_texto> ::= <comillaDoble> <texto> <comillaDoble> 
    <caracter_literal> ::= <comillaSimple> <caracter> <comillaSimple> | <simbolo>
    <valor_numerico> ::= <entero> | <flotante>
    <valor> ::= <valor_numerico> | <exponencial> | <bool> | <cadena_texto> | <identificador> | <caracter_literal>
    <tipo> ::= <tipoInt> | <tipoFloat> | <tipoBool> | <tipoChar> | <tipoString> | <tipoVoid>
    <negativo> ::= <negativoNumero> <entero> | <negativoNumero> <flotante>

Identificadores
    <identificador> ::= <letra> | <letra> <resto_id>
    <resto_id> ::= <letra> | <digito> | <letra> <resto_id> | <digito> <resto_id> | <guionBajo> <letra> | <guionBajo> <digito> | <guionBajo> <letra> <resto_id> | <guionBajo> <digito> <resto_id>

Variables
    <variable> ::= <identificador>
    <def_variable> ::= <palabraVal> <tipo> <identificador> (<fin_sentencia> | <asignacion> <expresion> <fin_sentencia>) 
    <def_var_global> ::= <varGlobal> <def_variable> 
    <def_var_local> ::= <varLocal> <def_variable> 
    <asignacion_variable> ::= <variable> <asignacion> <expresion> <fin_sentencia>

Entrada y salida
    <lectura> ::= <leer> <variable> <fin_sentencia>
    <escritura> ::= <escribir> <valor_escritura> <fin_sentencia>
    <valor_escritura> ::= <entero> | <flotante> | <bool> | <cadena_texto> | <variable>

Arreglos
    <indice> ::= <entero>
    <arreglo> ::= <identificador>
    <acceso_arreglo> ::= <arreglo> <abrir_corcheteCuadrados> <indice> <cerrar_corcheteCuadrados> ("arr ʃ:2:ʅ")
    <declaracion_arreglo> ::= <creacion_arreglo>
    <creacion_arreglo> ::= <arreglo_con_tamano> ("val int arr ʃ:3:ʅ »")
    <creacion_arreglo> ::= <arreglo_con_tamano_valores> ("val int arr ʃ:2:ʅ Ͱ ¿:2,3:? »")
    <creacion_arreglo> ::= <arreglo_sin_tamano_valores> ("val int arr ʃ::ʅ Ͱ ¿:1,2,3:? »")
    <arreglo_con_tamano> ::= <palabraVal> <tipo_arreglo> <identificador> <abrir_corcheteCuadrados> <indice> <cerrar_corcheteCuadrados> <fin_sentencia>
    <arreglo_con_tamano_valores> ::= <palabraVal> <tipo_arreglo> <identificador> <abrir_corcheteCuadrados> <indice> <cerrar_corcheteCuadrados> <asignacion> <abrir_bloque> <lista_arreglo> <cerrar_bloque> <fin_sentencia>
    <arreglo_sin_tamano_valores> ::= <palabraVal> <tipo_arreglo> <identificador> <abrir_corcheteCuadrados> <cerrar_corcheteCuadrados> <asignacion> <abrir_bloque> <lista_arreglo> <cerrar_bloque> <fin_sentencia>
    <lista_arreglo> ::= <inicio_lista_arreglo>
    <inicio_lista_arreglo> ::= <valor_numerico> <continuacion_lista_arreglo>
    <continuacion_lista_arreglo> ::= <coma> <valor_numerico> <continuacion_lista_arreglo> | <vacio>
    <modificacion_arreglo> ::= <acceso_arreglo> <asignacion> <valor_numerico> <fin_sentencia> ("arr ʃ:1:ʅ Ͱ 8 »")
    <tipo_arreglo> ::= <tipoInt>
    <tipo_arreglo> ::= <tipoFloat>

Comentarios
    <comentario_linea> ::= <simboloComentarioLinea> <texto>
    <comentario_multilinea> ::= <simboloInicioComentario> <texto> <simboloFinComentario>
    <comentario> ::= <comentario_linea> | <comentario_multilinea>

Operaciones aritmeticas --------REVISAR SECCION---------
    <operador_suma> ::= <simboloSuma> | <simboloResta>
    <operador_multiplicacion> ::= <simboloMultiplicacion> | <simboloDivision> | <simboloDivisionEntera>
    <valor_aritmetico> ::= <valor_numerico> | <negativo> | <identificador> | <acceso_arreglo> | <llamada_funcion> | <abrir_parentesis> <expresion_aritmetica> <cerrar_parentesis>
    <expresion_potencia> ::= <valor_aritmetico> <operadorPotencia> <expresion_potencia> | <valor_aritmetico>
    <expresion_suma> ::= <expresion_suma> <operador_suma> <expresion_potencia> | <expresion_potencia>
    <expresion_multiplicacion> ::= <expresion_suma>  <operador_multiplicacion> <expresion_multiplicacion> | <expresion_suma>
    <expresion_modulo> ::= <expresion_modulo> <modulo> <expresion_multiplicacion> | <expresion_multiplicacion>
    <expresion_aritmetica> ::= <expresion_modulo>

Operaciones relacionales
    <operadorRelacional> ::= <simboloMenor> | <simboloMayor> | <simboloMenorIgual> | <simboloMayorIgual> | <simboloIgual> | <simboloDiferente>
    <operando_relacional> ::= <abrir_corcheteCuadrados> (<expresion_aritmetica> | <valor>) <cerrar_corcheteCuadrados> ------REVISAR VALORES OPERACIONALES------
    <operacion_relacional> ::= <operando_relacional> <operador_relacional> <operando_relacional>

Expresiones lg  
    <condicion_basica> ::= <abrir_parentesis> <operacion_relacional> <cerrar_parentesis> | <abrir_parentesis> <bool> <cerrar_parentesis> ("є: ʃ:edad:ʅ > ʃ:18:ʅ :э")
    <condiciones_and> ::= <condicion_basica> <simboloAnd> <condicion_basica> ("є: ʃ:edad:ʅ > ʃ:18:ʅ :э λ є: ʃ:edad:ʅ < ʃ:65:ʅ :э")
    <condiciones_or> ::= <condicion_basica> <simboloOr> <condicion_basica>
    <condiciones_logicas> ::= <abrir_parentesis> (<condiciones_and> | <condiciones_or>) <cerrar_parentesis> ("є: є: ʃ:edad:ʅ > ʃ:18:ʅ :э λ є: ʃ:edad:ʅ < ʃ:65:ʅ :э :э")
    <negacion> ::= <not> (<condicion_basica> | <condiciones_logicas>) 
    <expresion_logica> ::= <condiciones_and> | <condiciones_or> | <negacion>

Expresiones y funciones
    <expresion> ::= <expresion_aritmetica> | <operacion_relacional> | <expresion_logica> | <valor>
    <lista_expresiones> ::= <vacio> | <expresion> | <expresion> <coma> <lista_expresiones>
    <llamada_funcion> ::= <identificador> <abrir_parentesis> <lista_expresiones> <cerrar_parentesis> 

Estructuras de control
    <if> ::= <palabraIf> <abrir_parentesis> <expresion> <cerrar_parentesis> <abrir_bloque> <bloque> <cerrar_bloque> <demas_if> 
    <demas_if> ::= <cadena_elif> <fin_if> | <fin_if>
    <fin_if> ::= <else> | <vacio>
    <elif> ::= <palabraElif> <abrir_parentesis> <expresion> <cerrar_parentesis> <abrir_bloque> <bloque> <cerrar_bloque>
    <cadena_elif> ::= <elif> | <elif> <cadena_elif>
    <else> ::= <palabraElse> <abrir_bloque> <bloque> <cerrar_bloque> 
    <while> ::= <palabraWhile> <abrir_parentesis> <expresion> <cerrar_parentesis> <abrir_bloque> <bloque> <cerrar_bloque>
    <for> ::= <palabraFor> <abrir_parentesis> (<variable> <asignacion> <valor> | <variable>) <fin_sentencia> <expresion> <fin_sentencia> (<incremento> | <decremento>) <cerrar_parentesis> <abrir_bloque> <bloque> <cerrar_bloque>
    <estructura_control> ::= <if> | <while> | <for>

Sentencias y bloques
    <break> ::= <palabraBreak>
    <return> ::= <palabraReturn> | <palabraReturn> <abrir_parentesis> (<expresion> | <variable>) <cerrar_parentesis>
    <instruccion> ::= (<asignacion_variable> | <def_variable> | <def_var_global> | <def_var_local> | <estructura_control> | <comentario> | (<expresion> | <break> | <return>) | <leer> | <escribir>) <fin_sentencia>
    <lista_instrucciones> ::= <instruccion> | <instruccion> <lista_instrucciones>
    <bloque> ::= <lista_instrucciones>
    
Parametros y funciones
    <tipo_funcion> ::= <tipoVoid> | <tipoInt> | <tipoFloat> | <tipoBool> -------REVISAR SI FALTAN MAS------- 
    <parametro> ::= <tipo> <identificador>
    <lista_parametros> ::= <vacio> | <parametro> | <parametro> <coma> <lista_parametros>
    <funcion> ::= <palabraDefun> <tipo_funcion> <identificador> <abrir_parentesis> <lista_parametros> <cerrar_parentesis> <abrir_bloque> <bloque> <cerrar_bloque>
    <lista_funciones> ::= <vacio> | <funcion> | <funcion> <lista_funciones>
    <principal> ::= <tipoVoid> <palabraPrincipal> <abrir_parentesis> <cerrar_parentesis> <abrir_bloque> <bloque> <cerrar_bloque> <fin_sentencia>
    <programa> ::= <lista_funciones> <principal>